# ─── Database Connection (Supabase + pgbouncer) ───────────────────────────────
#
# DATABASE_URL: Used by Prisma at runtime for all queries.
# Must point to pgbouncer (port 6543) with connection_limit parameter.
# The connection_limit should be set low for Vercel serverless (1-10 per instance).
# Recommended: connection_limit=5 for Vercel serverless functions.
#
# Format: postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true&connection_limit=5
#
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"

# DIRECT_URL: Used by Prisma ONLY for migrations and introspection (prisma db push, prisma migrate).
# Must point directly to PostgreSQL (port 5432), bypassing pgbouncer.
# This is required because pgbouncer does not support the extended query protocol
# used by Prisma during schema migrations.
#
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
#
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── Authentication ───────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Google Sheets API ────────────────────────────────────────────────────────
GOOGLE_SHEETS_API_KEY="your-google-sheets-api-key"

# ─── AI (Groq) ───────────────────────────────────────────────────────────────
GROQ_API_KEY="your-groq-api-key"

# ─── Cron Jobs ───────────────────────────────────────────────────────────────
# Required by Vercel Cron. Generate via `openssl rand -hex 32`.
# Vercel auto-sends Authorization: Bearer ${CRON_SECRET} ke handler.
CRON_SECRET="your-cron-secret"
